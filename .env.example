# Server-side GroqCloud API Key
# Used securely by the /api/chat serverless function and local Vite dev middleware.
# Never expose this key to client-side bundles or use the VITE_ prefix.
# Obtain a key from GroqCloud Console: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Groq model identifier (defaults to openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b
